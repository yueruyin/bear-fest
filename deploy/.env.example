COMPOSE_PROJECT_NAME=bear-fest
APP_TAG=latest
BACKEND_IMAGE=bear-fest-backend
FRONTEND_IMAGE=bear-fest-web

# 国内依赖源。已有 .env 不添加这些配置也会使用下列默认值。
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
NPM_SOURCE_PREFIX=https://nexus.zt.com.cn:38081/repository/npm-public

# 本地测试使用 :80；正式环境改为已解析到服务器的域名，例如 example.com。
# 填写域名后 Caddy 会自动申请并续期 HTTPS 证书。
SITE_ADDRESS="www.cqxx.cloud, cqxx.cloud, :80"
HTTP_PORT=80
HTTPS_PORT=443

# MySQL。密码建议只使用大小写字母、数字和下划线，长度至少 16 位。
MYSQL_DATABASE=bear_fest
MYSQL_USER=bear_fest
MYSQL_PASSWORD=XiaoXiong-DB-2026
MYSQL_ROOT_PASSWORD=root
MYSQL_DATA_DIR=./data/mysql
MYSQL_HOST_PORT=3306

# 管理后台。
ADMIN_JWT_SECRET=41ac197e13fcef0d3093ec2381e55e128d0873725a5d43c983a12b0d97e25c03
ADMIN_JWT_EXPIRES_MINUTES=720
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=XiaoXiong2026

# 同域部署保持为空即可；多个来源用英文逗号分隔。
CORS_ALLOW_ORIGINS=
VITE_API_BASE_URL=

# 当前使用建表初始化，单后端实例即可。后续接入 Alembic 后可关闭自动初始化。
RUN_DB_INIT=1
UVICORN_WORKERS=1
